publicnearcade.cutefame.net {
    encode gzip

    @inputWs {
        header Connection *Upgrade*
        header Upgrade    websocket
        path   /ws/input
    }
    reverse_proxy @inputWs localhost:3001

    @localWs {
        header Connection *Upgrade*
        header Upgrade    websocket
        path   /ws/*
    }
    reverse_proxy @localWs localhost:3000

    @vpsWs {
        header Connection *Upgrade*
        header Upgrade    websocket
        path   /vps
    }
    reverse_proxy @vpsWs localhost:3000

    # API and dynamic routes served by the Node.js application server
    reverse_proxy /api/*         localhost:3001
    
    # Delegate all static assets to the Node.js express server (Zero-maintenance mapping)
    reverse_proxy /js/*          localhost:3001
    reverse_proxy /css/*         localhost:3001
    reverse_proxy /assets/*      localhost:3001
    reverse_proxy /favicon*      localhost:3001

    # Static file rewrites (for root pages)
    root * /home/ubuntu/Nearcade

    rewrite /               /src/pages/index.html
    rewrite /viewer.html    /src/pages/viewer.html
    rewrite /host.html      /src/pages/host.html
    rewrite /dashboard.html /src/pages/dashboard.html
    rewrite /gamepad-popup.html /src/pages/gamepad-popup.html
    rewrite /keyboard-popup.html /src/pages/keyboard-popup.html
    rewrite /display-color-tweaks.html /src/pages/display-color-tweaks.html
    rewrite /standby.html   /src/pages/standby.html

    file_server
}
