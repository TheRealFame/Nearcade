{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nearcade Sidecapture",
  "version": "0.1.0",
  "identifier": "net.cutefame.nearcade-sidecapture",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Nearcade Sidecapture",
        "width": 400,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": ["bin/scrcpy/**/*"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  }
}
